{
  "collectionName": "components_shared_buttons",
  "info": {
    "displayName": "Button",
    "icon": "write"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "variant": {
      "type": "enumeration",
      "default": "primary",
      "enum": [
        "default",
        "primary",
        "destructive",
        "outline",
        "secondary",
        "ghost",
        "link",
        "blue",
        "red"
      ]
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "className": {
      "type": "string"
    },
    "is_external": {
      "type": "boolean",
      "default": true
    },
    "href": {
      "type": "string",
      "required": true,
      "regex": "^(?:https?:\\/\\/(?:www\\.)?[-a-zA-Z0-9@:%._+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6})?(?:\\/[-a-zA-Z0-9()@:%_+.~#?&\\/=]*)?$"
    }
  },
  "config": {}
}
